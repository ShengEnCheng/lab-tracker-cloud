# 研究室追蹤系統 —— 環境變數範例
#
# 正式部署（Vercel）時，這些變數要設在 Vercel 專案的
# Settings → Environment Variables，不是這個檔案裡。
# 這個檔案只給「在本機測試」時複製成 .env.local 使用。
#
# 注意：.env.local 絕對不要 commit 進 Git。

# 你的 Supabase 專案網址（長得像 https://abcdefgh.supabase.co）
SUPABASE_URL=

# 前端用的低權限金鑰。新的叫 publishable key（sb_publishable_...），
# 舊的部署叫 anon key（一長串 eyJ 開頭的 JWT）。兩者都支援。
SUPABASE_PUBLISHABLE_KEY=

# 伺服器用的高權限金鑰。新的叫 secret key（sb_secret_...），
# 舊的叫 service_role key。這把能繞過所有權限規則，絕對不能外流。
SUPABASE_SECRET_KEY=

# 保護每日自動備份的密碼（任意一長串亂數）。Vercel 的排程會自動帶上它，
# /api/backup 只認這組密碼。本機測試可以隨便填，例如：openssl rand -hex 32
CRON_SECRET=
