{
  "name": "lab-tracker-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "研究室多案追蹤系統（雲端範本，給任何研究室一鍵部署）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check-project.mjs",
    "check:wizard": "node wizard/sync-inline.mjs --check",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:session": "node tests/session-flow.test.mjs",
    "test:handoff": "node tests/handoff-flow.test.mjs",
    "test:roster": "node tests/roster.test.mjs",
    "test:export": "node tests/export-completeness.test.mjs",
    "test:import": "node tests/user-export-import.test.mjs",
    "test:import-ui": "node tests/import-button.test.mjs",
    "test:update": "node tests/update-path.test.mjs",
    "test:auto-update": "node tests/auto-update.test.mjs",
    "test:checkup": "node tests/feature-checkup.test.mjs",
    "test:wizard": "node tests/wizard.test.mjs",
    "test:journey": "node tests/wizard-journey.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test:all": "npm run check && npm run check:wizard && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:session && npm run test:handoff && npm run test:roster && npm run test:export && npm run test:import && npm run test:import-ui && npm run test:update && npm run test:auto-update && npm run test:checkup && npm run test:wizard && npm run test:journey && npm run test:ui",
    "verify:sql": "node scripts/verify-sql.mjs"
  }
}
